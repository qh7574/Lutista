#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(set = 0, binding = 2) uniform sampler3D lutTexture;
layout(set = 0, binding = 3) uniform sampler3D lut2Texture;
layout(set = 0, binding = 4) uniform FilterParams {
    float lutStrength;
    float lut2Strength;
    float lutSize;
    float lut2Size;
    float exposure;
    float contrast;
    float highlights;
    float shadows;
    float saturation;
    float colorTemperature;
    float tint;
    float vignetteStrength;
    float grainStrength;
    float grainSeed;
    float shadowThreshold;
    float highlightThreshold;
    float shadowGrainRatio;
    float midtoneGrainRatio;
    float highlightGrainRatio;
    float shadowSizeRatio;
    float highlightSizeRatio;
    int enableLut;
    int enableLut2;
    int enableGrain;
    int width;
    int height;
    // LCH adjustments: 8 zones * 3 (lightness, chroma, hue)
    float lchRed_L;     float lchRed_C;     float lchRed_H;
    float lchOrange_L;  float lchOrange_C;  float lchOrange_H;
    float lchYellow_L;  float lchYellow_C;  float lchYellow_H;
    float lchGreen_L;   float lchGreen_C;   float lchGreen_H;
    float lchCyan_L;    float lchCyan_C;    float lchCyan_H;
    float lchBlue_L;    float lchBlue_C;    float lchBlue_H;
    float lchPurple_L;  float lchPurple_C;  float lchPurple_H;
    float lchSkin_L;    float lchSkin_C;    float lchSkin_H;
    int enableLch;
    int enableCurve;
    // Extended grain parameters
    float midtoneSizeRatio;
    float redChannelRatio;
    float blueChannelRatio;
    float channelCorrelation;
    float colorPreservation;
    float grainSize;
    float lutGlobalStrength;
} params;

layout(std430, set = 0, binding = 5) readonly buffer CurveData {
    float curves[1028]; // R:0-255, G:256-511, B:512-767, W:768-1023, Sentinels:1024-1027
};

// sRGB to linear
vec3 srgbToLinear(vec3 s) {
    return mix(s / 12.92, pow((s + 0.055) / 1.055, vec3(2.4)), step(0.04045, s));
}
vec3 linearToSrgb(vec3 l) {
    return mix(l * 12.92, 1.055 * pow(l, vec3(1.0/2.4)) - 0.055, step(0.0031308, l));
}
// Photographic exposure: pure gain in *linear* light, followed by a film-style
// highlight roll-off (extended Reinhard) whose white point is pinned to the
// exposure gain.
//   srgb : display-encoded (non-linear sRGB) colour, expected in [0,1]
//   ev   : exposure in stops (Kotlin stores exposure as EV * 10, so this is
//          sliderValue / 10)
//
// Why not just `lin *= exp2(ev)`?
//   The gain itself is correct (that *is* one stop), but on an 8-bit SDR image a
//   pure gain clips everything above sRGB 0.73 at +1 EV, so a normal photo turns
//   into a flat white sheet after a small slider move. Editing apps that feel
//   "right" (Lightroom, Capture One) apply the gain and then run the result
//   through a film curve, which is why their +1 EV brightens the mid-tones but
//   keeps highlight detail.
//
// Response:
//   W    = clamp(gain, 1, MAX_ROLLOFF_GAIN)
//   out  = lin * (1 + lin / W^2) / (1 + lin),   lin = srgbToLinear(src) * gain
//
// Properties (all verified in ColorPipelineMathTest):
//   * ev <= 0  -> W = 1 and out == lin  (pure linear gain, no compression)
//   * ev == 0  -> out == src            (exact identity; also short-circuited
//                                        in main() so the pass is free)
//   * out(W) == 1  -> the source white lands on exactly 1.0, so white stays
//                     white instead of turning grey
//   * strictly increasing, no NaN/Inf for any input in [0,1] x [-5,5]
//   * continuous at ev = 0: W -= 1 and the curve collapses to identity
// W is pinned to the gain so the source white stays white; the cap only kicks in
// above +2 EV, where it keeps a large +EV driving the image to white instead of
// asymptotically stalling at grey. Raise MAX_ROLLOFF_GAIN for a softer top end
// at extreme EV, lower it towards 1 for a harder, more "digital" response.
const float MAX_ROLLOFF_GAIN = 4.0;

vec3 applyExposure(vec3 srgb, float ev) {
    float gain = exp2(ev);
    float w = clamp(gain, 1.0, MAX_ROLLOFF_GAIN);
    vec3 lin = srgbToLinear(clamp(srgb, 0.0, 1.0)) * gain;
    lin = lin * (1.0 + lin / (w * w)) / (1.0 + lin);
    return linearToSrgb(clamp(lin, 0.0, 1.0));
}

// Linear sRGB to Oklab
vec3 linearToOklab(vec3 c) {
    // Ensure non-negative input to pow(1/3) for numerical stability on Mali
    float l = max(0.0, 0.4122214708*c.r + 0.5363325363*c.g + 0.0514459929*c.b);
    float m = max(0.0, 0.2119034982*c.r + 0.6806995451*c.g + 0.1073969566*c.b);
    float s = max(0.0, 0.0883024619*c.r + 0.2817188376*c.g + 0.6299787005*c.b);
    float l_ = pow(l, 1.0/3.0);
    float m_ = pow(m, 1.0/3.0);
    float s_ = pow(s, 1.0/3.0);
    return vec3(
        0.2104542553*l_ + 0.7936177850*m_ - 0.0040720468*s_,
        1.9779984951*l_ - 2.4285922050*m_ + 0.4505937099*s_,
        0.0259040371*l_ + 0.7827717662*m_ - 0.8086757660*s_
    );
}
// Oklab to linear sRGB
vec3 oklabToLinear(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    float l = l_*l_*l_;
    float m = m_*m_*m_;
    float s = s_*s_*s_;
    return vec3(
         4.0767416621*l - 3.3077115913*m + 0.2309699292*s,
        -1.2684380046*l + 2.6097574011*m - 0.3413193965*s,
        -0.0041960863*l - 0.7034186147*m + 1.7076147010*s
    );
}

float random(vec2 co, float seed) {
    return fract(sin(dot(co + seed, vec2(12.9898, 78.233))) * 43758.5453);
}

float gaussianNoise(vec2 uv, float seed) {
    float u1 = max(random(uv, seed), 0.0001);
    float u2 = random(uv, seed + 0.5);
    return sqrt(-2.0 * log(u1)) * cos(6.28318 * u2);
}

float smoothstep3(float t) {
    float x = clamp(t, 0.0, 1.0);
    return x * x * (3.0 - 2.0 * x);
}

float getGrainRatio(float lum, float threshLow, float threshHigh,
                    float ratioLow, float ratioMid, float ratioHigh) {
    float tw = 0.04;
    if (lum < threshLow - tw) return ratioLow;
    if (lum < threshLow + tw) return mix(ratioLow, ratioMid, smoothstep3((lum - (threshLow - tw)) / (2.0 * tw)));
    if (lum < threshHigh - tw) return ratioMid;
    if (lum < threshHigh + tw) return mix(ratioMid, ratioHigh, smoothstep3((lum - (threshHigh - tw)) / (2.0 * tw)));
    return ratioHigh;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= params.width || coord.y >= params.height) return;

    vec4 color = imageLoad(inputImage, coord);
    vec3 c = color.rgb;
    vec3 preLut = c;

    // 1. LUT1
    if (params.enableLut == 1 && params.lutStrength > 0.0) {
        vec3 scaled = c * (params.lutSize - 1.0);
        vec3 lutCoord = (scaled + 0.5) / params.lutSize;
        vec3 lutColor = texture(lutTexture, clamp(lutCoord, 0.0, 1.0)).rgb;
        c = mix(c, lutColor, params.lutStrength);
    }

    // 2. LUT2
    if (params.enableLut2 == 1 && params.lut2Strength > 0.0) {
        vec3 scaled = c * (params.lut2Size - 1.0);
        vec3 lutCoord = (scaled + 0.5) / params.lut2Size;
        vec3 lut2Color = texture(lut2Texture, clamp(lutCoord, 0.0, 1.0)).rgb;
        c = mix(c, lut2Color, params.lut2Strength);
    }

    // Global LUT strength: blend between original and LUT-processed
    if ((params.enableLut == 1 || params.enableLut2 == 1) && params.lutGlobalStrength < 1.0) {
        c = mix(preLut, c, params.lutGlobalStrength);
    }

    // 3. Brightness: exposure (linear light + soft highlight shoulder).
    //    Skipped when EV == 0 so the operation is an exact identity.
    if (params.exposure != 0.0) {
        c = applyExposure(c, params.exposure);
    }

    // 4. Brightness: contrast
    if (params.contrast != 0.0) {
        float factor = (100.0 + params.contrast) / 100.0;
        c = (c - 0.5) * factor + 0.5;
    }

    // 5. Brightness: highlights/shadows
    if (params.highlights != 0.0 || params.shadows != 0.0) {
        float lum = dot(c, vec3(0.299, 0.587, 0.114));
        float highlightMask = smoothstep(0.5, 1.0, lum);
        float shadowMask = 1.0 - smoothstep(0.0, 0.5, lum);
        float adj = (params.highlights / 100.0) * highlightMask * 0.3
                  + (params.shadows / 100.0) * shadowMask * 0.3;
        c += adj;
    }

    // 6. Color: saturation
    if (params.saturation != 0.0) {
        float gray = dot(c, vec3(0.299, 0.587, 0.114));
        float factor = 1.0 + params.saturation / 100.0;
        c = gray + (c - gray) * factor;
    }

    // 7. Color: temperature (chromatic *gain*).
    //    An additive offset would lift pure black and tint it (0,0,0) ->
    //    (+0.5,0,-0.5) at full strength; a multiplicative gain keeps black
    //    black and white white, which is the minimum a white-balance control
    //    must guarantee. Range: +/-100 slider -> +/-0.5 gain (+/-50%).
    if (params.colorTemperature != 0.0) {
        float adj = params.colorTemperature / 200.0;
        c.r *= max(1.0 + adj, 0.0);
        c.b *= max(1.0 - adj, 0.0);
    }

    // 8. Color: tint (green <-> magenta chromatic gain).
    if (params.tint != 0.0) {
        float adj = params.tint / 200.0;
        c.g *= max(1.0 + adj, 0.0);
    }

    // 9. Curve: White (master) maps all channels, then per-channel curves modify individually.
    // Sentinels at 1024-1027 (outside LUT range, no corruption).
    if (params.enableCurve == 1) {
        if (curves[1027] > 0.5) {
            c.r = curves[768 + clamp(int(clamp(c.r, 0.0, 1.0) * 255.0), 0, 255)];
            c.g = curves[768 + clamp(int(clamp(c.g, 0.0, 1.0) * 255.0), 0, 255)];
            c.b = curves[768 + clamp(int(clamp(c.b, 0.0, 1.0) * 255.0), 0, 255)];
            c = clamp(c, 0.0, 1.0);
        }
        if (curves[1024] > 0.5) c.r = curves[clamp(int(clamp(c.r, 0.0, 1.0) * 255.0), 0, 255)];
        if (curves[1025] > 0.5) c.g = curves[256 + clamp(int(clamp(c.g, 0.0, 1.0) * 255.0), 0, 255)];
        if (curves[1026] > 0.5) c.b = curves[512 + clamp(int(clamp(c.b, 0.0, 1.0) * 255.0), 0, 255)];
        c = clamp(c, 0.0, 1.0);
    }

    // 10. LCH
    if (params.enableLch == 1) {
        vec3 lin = srgbToLinear(c);
        vec3 oklab = linearToOklab(lin);
        float L = oklab.x;
        float C = length(oklab.yz);
        float H = atan(oklab.z, oklab.y);
        if (H < 0.0) H += 6.28318;
        float centers[8] = float[8](0.0, 0.5, 1.05, 2.1, 3.14, 4.2, 5.2, 0.4);
        float zoneWidth = 0.7854;
        float totalL = 0.0, totalC = 0.0, totalH = 0.0;
        float totalWeight = 0.0;
        vec3 adj[8] = vec3[8](
            vec3(params.lchRed_L, params.lchRed_C, params.lchRed_H),
            vec3(params.lchOrange_L, params.lchOrange_C, params.lchOrange_H),
            vec3(params.lchYellow_L, params.lchYellow_C, params.lchYellow_H),
            vec3(params.lchGreen_L, params.lchGreen_C, params.lchGreen_H),
            vec3(params.lchCyan_L, params.lchCyan_C, params.lchCyan_H),
            vec3(params.lchBlue_L, params.lchBlue_C, params.lchBlue_H),
            vec3(params.lchPurple_L, params.lchPurple_C, params.lchPurple_H),
            vec3(params.lchSkin_L, params.lchSkin_C, params.lchSkin_H)
        );
        for (int i = 0; i < 8; i++) {
            float diff = abs(H - centers[i]);
            if (diff > 3.14159) diff = 6.28318 - diff;
            float sigma = zoneWidth * 0.6;
            float weight = exp(-diff * diff / (2.0 * sigma * sigma));
            if (weight > 0.01) {
                totalL += adj[i].x * weight;
                totalC += adj[i].y * weight;
                totalH += adj[i].z * weight;
                totalWeight += weight;
            }
        }
        if (totalWeight > 0.0) {
            L = clamp(L + totalL / 100.0 * 0.5, 0.0, 1.0);
            C = max(C + totalC / 100.0 * 0.3, 0.0);
            H += totalH / 100.0 * 0.5;
            if (H < 0.0) H += 6.28318;
            if (H >= 6.28318) H -= 6.28318;
            oklab = vec3(L, C * cos(H), C * sin(H));
            lin = oklabToLinear(oklab);
            c = linearToSrgb(clamp(lin, 0.0, 1.0));
        }
    }

    // 11. Grain
    if (params.enableGrain == 1 && params.grainStrength > 0.0) {
        float lum = dot(c, vec3(0.299, 0.587, 0.114));
        float strengthRatio = getGrainRatio(lum, params.shadowThreshold, params.highlightThreshold,
                                            params.shadowGrainRatio, params.midtoneGrainRatio, params.highlightGrainRatio);
        float sizeRatio = getGrainRatio(lum, params.shadowThreshold, params.highlightThreshold,
                                        params.shadowSizeRatio, params.midtoneSizeRatio, params.highlightSizeRatio);
        // Amplitude depends on strength only. Grain *size* must not scale the
        // amplitude (it used to be multiplied in twice: once here and once in
        // grainUV), otherwise "size" silently became a second strength knob
        // and doubled the strength at grainSize = 10.
        float noiseStrength = params.grainStrength * strengthRatio * 0.1;
        // The grain period is normalised by the image *short side* instead of a
        // fixed 1000 px reference: with a pixel-based period the preview (short
        // side ≈1024) and the full resolution export (≈4000) showed the same
        // grain at ~3.9x different relative size. At shortSide = 1000 this is
        // bit-identical to the old formula, so a 1000x1000 image does not move.
        float shortSide = float(min(params.width, params.height));
        float grainPeriod = max(params.grainSize * sizeRatio * shortSide, 1.0);
        vec2 grainUV = vec2(coord) / grainPeriod;
        float baseNoise = gaussianNoise(grainUV, params.grainSeed);
        float redNoise = mix(gaussianNoise(grainUV, params.grainSeed + 0.1), baseNoise, params.channelCorrelation);
        float greenNoise = mix(gaussianNoise(grainUV, params.grainSeed + 0.2), baseNoise, params.channelCorrelation);
        float blueNoise = mix(gaussianNoise(grainUV, params.grainSeed + 0.3), baseNoise, params.channelCorrelation);
        vec3 noise = vec3(
            redNoise * params.redChannelRatio,
            greenNoise,
            blueNoise * params.blueChannelRatio
        ) * noiseStrength;
        vec3 uniformNoise = vec3(baseNoise * noiseStrength);
        noise = mix(noise, uniformNoise, 1.0 - params.colorPreservation);
        c += noise;
    }

    // 12. Vignette
    if (params.vignetteStrength != 0.0) {
        vec2 center = vec2(float(params.width) / 2.0, float(params.height) / 2.0);
        float maxDist = max(length(center), 1.0);
        vec2 delta = vec2(float(coord.x), float(coord.y)) - center;
        float normDist = length(delta) / maxDist;
        if (params.vignetteStrength > 0.0) {
            // Darkening stays a display-domain multiply: vig <= 1 can never
            // clip, and this keeps the look of already saved filters intact.
            float vig = 1.0 - (normDist * params.vignetteStrength / 100.0);
            c *= clamp(vig, 0.0, 1.0);
        } else {
            // Brightening is a light gain, so it must be applied in linear
            // light: multiplying the sRGB encoding by up to 2.0 used to push
            // every corner pixel above 0.5 to pure white (blown out corners).
            float vig = 1.0 + (normDist * (-params.vignetteStrength) / 100.0);
            c = linearToSrgb(clamp(srgbToLinear(clamp(c, 0.0, 1.0)) * clamp(vig, 0.0, 2.0), 0.0, 1.0));
        }
    }

    imageStore(outputImage, coord, vec4(clamp(c, 0.0, 1.0), color.a));
}
